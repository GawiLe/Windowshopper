# Neon: de app verbindt met de rol windowshop_app (geen eigenaar, RLS geldt altijd)
DATABASE_URL="postgresql://windowshop_app:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Alleen voor schema/seed (eigenaar-rol), niet in de app gebruiken
DATABASE_URL_OWNER="postgresql://neondb_owner:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Foto's en logo's (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# E-mail (Resend)
RESEND_API_KEY=""
# {domain} wordt per winkelgebied vervangen door het domein (bv. kado@shoppenkempenaer.nl)
MAIL_FROM="Windowshoppen <kado@{domain}>"

# Algemeen
AUTH_SECRET=""      # lange willekeurige string, bv. `openssl rand -base64 32`
CRON_SECRET=""      # beveiligt /api/cron (Vercel stuurt hem mee)
